# Configuración CLI. Copia a .env en tu proyecto o usa ares config init.
# Selecciona un ID de modelo disponible en la cuenta de tu proveedor.
ARES_PROVIDER=openrouter
ARES_MODEL=
OPENROUTER_API_KEY=

# Proveedores adicionales. Guarda las claves reales solo en tu archivo privado.
# MISTRAL_API_KEY=
# GROQ_API_KEY=
# COHERE_API_KEY=

# Perfiles de modelo opcionales. Usa IDs obtenidos con ares models --provider NOMBRE.
# OPENROUTER_MODEL=
# GEMINI_MODEL=
# MISTRAL_MODEL=
# GROQ_MODEL=
# COHERE_MODEL=
# COMPATIBLE_MODEL=
# OLLAMA_MODEL=

# Alternativa Gemini:
# ARES_PROVIDER=gemini
# ARES_MODEL=
# GEMINI_API_KEY=

# Alternativa local (servidor compatible ya iniciado, por ejemplo Ollama):
# ARES_PROVIDER=compatible
# ARES_MODEL=
# ARES_BASE_URL=http://127.0.0.1:11434/v1
# COMPATIBLE_API_KEY=

# ARES_TIMEOUT_MS=120000
# ARES_MAX_TOKENS=8192
# Motor Ollama nativo opcional: instala Ollama y usa ares local use ID.
# ARES_PROVIDER=ollama
# OLLAMA_MODEL=qwen2.5-coder:7b
# ARES_LOCAL_CONTEXT=4096
# Sin ARES_LOCAL_CONTEXT, el presupuesto local se calcula automáticamente.
# En Ollama el límite de salida predeterminado es 1024, con tope de 1/4 del contexto.
# ARES_HOME=C:/ruta/privada/ares-data
