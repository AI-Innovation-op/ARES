{
  "name": "ares-ecosystem",
  "version": "5.7.1",
  "private": true,
  "description": "ARES CLI independiente y espacio web de ingeniería con avatar 3D.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "setup": "npm --prefix cli ci --ignore-scripts && npm run build",
    "build": "npm --prefix cli run build",
    "test": "npm --prefix cli test",
    "check": "npm --prefix cli run check",
    "portable": "npm --prefix cli run portable",
    "smoke:portable": "npm --prefix cli run smoke:portable",
    "package:npm": "npm --prefix cli run package:npm",
    "smoke:npm": "npm --prefix cli run smoke:npm",
    "install:global": "npm --prefix cli run install:global",
    "ares": "node cli/dist/index.js"
  }
}
