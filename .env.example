# ============================================================================
# PLANTILLA DEL BACKEND HISTÓRICO. Para CLI 5 usa cli/.env.example o ares config init.
# Copia este archivo a .env y asigna al menos UNA clave de LLM (GEMINI_API_KEY u OPENROUTER_API_KEY).
# ============================================================================

# --- Motor de Base de Datos ---
# Opciones para DB_DRIVER: 'sqlite' (predeterminado local) o 'postgres'
DB_DRIVER=sqlite
SQLITE_DB_PATH=./database/ares.db

# Configuración si usas PostgreSQL 16+ con Docker Compose:
POSTGRES_USER=ares_commander
POSTGRES_PASSWORD=ares_dev_2026
POSTGRES_DB=ares_db
DATABASE_URL=postgresql://ares_commander:ares_dev_2026@localhost:5432/ares_db

# --- Caché Redis (Opcional, degradación elegante en memoria si no está activo) ---
REDIS_URL=redis://localhost:6379

# --- Google Gemini AI API ---
# Obtén tu clave en https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_clave_de_gemini_aqui
GEMINI_TEXT_MODEL=gemini-3-flash-preview
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Orus

# --- OpenRouter Multi-Model Gateway ---
# Soporta Claude 3.5 Sonnet, DeepSeek V3/R1, GPT-4o, Llama 3.3
# Obtén tu clave en https://openrouter.ai/keys
OPENROUTER_API_KEY=tu_clave_de_openrouter_aqui
OPENROUTER_DEFAULT_MODEL=deepseek/deepseek-chat
LLM_PROVIDER=gemini

# --- Configuración del Servidor API ---
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- Seguridad de la API ---
# Clave de acceso a TODA la API (cabecera x-api-key). OBLIGATORIA si NODE_ENV=production.
# En desarrollo puedes dejarla vacía. Genera una con:  openssl rand -hex 32
ARES_API_KEY=
# Saltos de proxy delante del backend (0 = sin proxy / local; 1 = Render o un nginx; 2 = Render + nginx propio)
TRUST_PROXY_HOPS=0
