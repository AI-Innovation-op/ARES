# ============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO: A.R.E.S. Backend (Node.js + Express 5)
# Copia este archivo a backend/.env y asigna al menos UNA clave de LLM (GEMINI_API_KEY u OPENROUTER_API_KEY).
# ============================================================================

DB_DRIVER=sqlite
SQLITE_DB_PATH=../database/ares.db
DATABASE_URL=postgresql://ares_commander:ares_dev_2026@localhost:5432/ares_db

REDIS_URL=redis://localhost:6379

GEMINI_API_KEY=tu_clave_de_gemini_aqui
GEMINI_TEXT_MODEL=gemini-3-flash-preview
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Orus

OPENROUTER_API_KEY=tu_clave_de_openrouter_aqui
OPENROUTER_DEFAULT_MODEL=deepseek/deepseek-chat
LLM_PROVIDER=gemini

PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- Seguridad de la API ---
# Clave de acceso a TODA la API (cabecera x-api-key). OBLIGATORIA si NODE_ENV=production.
# En desarrollo puedes dejarla vacía. Genera una con:  openssl rand -hex 32
ARES_API_KEY=
# Saltos de proxy delante del backend (0 = sin proxy / local; 1 = Render o un nginx; 2 = Render + nginx propio)
TRUST_PROXY_HOPS=0
